# STRATIX AI Coach backend environment variables.
# Copy this file to .env and fill in your own values.
# .env is already git-ignored — never commit real secrets.

# Required. Your OpenRouter API key. Server-side only: this must never be
# prefixed with VITE_ or referenced from any client-side/React code, since
# anything prefixed VITE_ gets bundled into the browser build.
OPENROUTER_API_KEY=

# Optional. OpenRouter model slug to use. Defaults to OpenRouter's free
# model router (currently openrouter/free:free) if left unset. Browse
# available models at https://openrouter.ai/models
OPENROUTER_MODEL=openrouter/free:free

# Optional. Port the backend listens on.
PORT=8787

# Optional. Sent as the HTTP-Referer header on OpenRouter requests (used
# for OpenRouter's own app analytics/rankings — not required to function).
OPENROUTER_SITE_URL=http://localhost:5178

# ---------------------------------------------------------------------------
# Riot Sign On (RSO) + VALORANT data. All server-side only — never prefix
# these with VITE_. Leave blank until Riot approves your RSO client: STRATIX
# runs normally and shows "Connect Riot" / "not available yet" states.
# ---------------------------------------------------------------------------

# SAME-ORIGIN REQUIREMENT (enforced by the server at startup):
#   The site and /api must be served from ONE origin = APP_URL. The RSO
#   nonce and the Riot sign-in ticket are httpOnly cookies scoped to
#   /api/riot, and the frontend calls /api/riot/* with relative URLs.
#   * Dev: Vite (APP_URL) proxies /api to this server — works out of the box.
#   * Production: put this server behind the same domain as the site (reverse
#     proxy /api -> this server), set NODE_ENV=production, and use https.
#   If RIOT_REDIRECT_URI is not exactly APP_URL + /api/riot/callback, or
#   production APP_URL is missing / not https, Riot sign-on stays DISABLED and
#   the server logs why.

# RSO client credentials issued by Riot.
RIOT_CLIENT_ID=
RIOT_CLIENT_SECRET=
# Must exactly match the redirect URI registered with Riot, and must be
# APP_URL + /api/riot/callback (same origin as the site).
RIOT_REDIRECT_URI=http://localhost:5173/api/riot/callback
# Production API key for VALORANT match data (val-match-v1). Without it a
# connected account shows identity only, with "no match data" states.
RIOT_API_KEY=
# Regional routing for account-v1 (americas | europe | asia).
RIOT_ACCOUNT_REGION=americas

# Public origin serving BOTH the site and /api (no trailing slash). Also the
# only browser origin allowed by CORS. Required (https) in production.
APP_URL=http://localhost:5173

# Supabase service-role key: lets the server write riot_connections /
# riot_player_data (clients can only read their own rows). Server-only.
SUPABASE_SERVICE_ROLE_KEY=
