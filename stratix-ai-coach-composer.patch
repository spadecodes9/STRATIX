+/* Composer — auto-growing textarea + compact controls row underneath,
+   replacing the old single-line .coach-input-row for the AI Coach page. */
+.coach-composer {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  padding: 14px 16px;
+  border-top: 1px solid var(--border);
+}
+.coach-composer-textarea {
+  width: 100%;
+  resize: none;
+  background: var(--black);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  padding: 12px 14px;
+  color: var(--white);
+  font-family: var(--font-body);
+  font-size: 14.5px;
+  line-height: 1.5;
+  min-height: 60px;
+  max-height: 160px;
+  overflow-y: auto;
+  transition: border-color 0.15s ease;
+}
+.coach-composer-textarea:focus { outline: none; border-color: var(--red); }
+.coach-composer-textarea:disabled { opacity: 0.6; cursor: not-allowed; }
+
+.coach-composer-actions {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+}
+.coach-composer-hint {
+  font-family: var(--font-mono);
+  font-size: 11px;
+  color: var(--gray-dim);
+  letter-spacing: 0.03em;
+}
+
+.ai-coach-footnote {
+  margin: 14px 4px 0;
+  text-align: center;
+  font-family: var(--font-mono);
+  font-size: 11.5px;
+  letter-spacing: 0.04em;
+  color: var(--gray-dim);
+}
+
 @media (max-width: 600px) {
-  .coach-panel { height: 70vh; }
+  .coach-panel { max-height: 75vh; }
+  .coach-composer-hint { display: none; }
 }
 
