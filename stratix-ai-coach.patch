+# STRATIX AI Coach backend environment variables.
+# Copy this file to .env and fill in your own values.
+# .env is already git-ignored — never commit real secrets.
+
+# Required. Your OpenRouter API key. Server-side only: this must never be
+# prefixed with VITE_ or referenced from any client-side/React code, since
+# anything prefixed VITE_ gets bundled into the browser build.
+OPENROUTER_API_KEY=
+
+# Optional. OpenRouter model slug to use. Defaults to OpenRouter's free
+# model router (currently openrouter/free:free) if left unset. Browse
+# available models at https://openrouter.ai/models
+OPENROUTER_MODEL=openrouter/free:free
+
+# Optional. Port the backend listens on.
+PORT=8787
+
+# Optional. Sent as the HTTP-Referer header on OpenRouter requests (used
+# for OpenRouter's own app analytics/rankings — not required to function).
+OPENROUTER_SITE_URL=http://localhost:5178
